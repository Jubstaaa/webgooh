# Public site URL (used for SEO, sitemap, canonical, revalidation)
NEXT_PUBLIC_SITE_URL=https://www.webgooh.com

# Search engine indexing. Only "true" allows indexing.
# Leave unset/false on staging & test domains so they stay noindex.
SITE_INDEXABLE=false

# Payload secret — generate with: openssl rand -base64 32
PAYLOAD_SECRET=change-me-in-production

# SQLite connection (file lives on a persistent Docker volume)
DATABASE_URI=file:./webgooh.db

# Cloudflare Turnstile — CF paneli > Turnstile > Add site (webgooh.com + localhost)
# Both are required: a production build fails without the site key, and the
# contact form rejects every submit without the secret. For local work use
# Cloudflare's test pair: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key
TURNSTILE_SECRET_KEY=your-secret-key

# Cloudflare Access (admin sign-in). Without both, Access sign-in is off and only
# the password form works. docker-compose.yml defaults them for production.
CF_ACCESS_TEAM_DOMAIN=https://webgooh.cloudflareaccess.com
CF_ACCESS_AUD=your-access-application-aud

# Spaces credentials for media uploads (production only)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
