# Public site URL (used for SEO, sitemap, canonical, revalidation)
NEXT_PUBLIC_SITE_URL=https://www.webgooh.com

# Search engine indexing. Only "true" allows indexing.
# Leave unset/false on staging & test domains so they stay noindex.
SITE_INDEXABLE=false

# Payload secret — generate with: openssl rand -base64 32
PAYLOAD_SECRET=change-me-in-production

# SQLite connection (file lives on a persistent Docker volume)
DATABASE_URI=file:./webgooh.db

# On-demand revalidation secret (Cloudflare / webhook trigger)
REVALIDATION_SECRET=change-me-too

# Preview / draft mode secret
PREVIEW_SECRET=preview-me

# Cloudflare Turnstile — CF paneli > Turnstile > Add site (webgooh.com + localhost)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key
TURNSTILE_SECRET_KEY=your-secret-key
