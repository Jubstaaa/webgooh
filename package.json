{
    "name": "webgooh",
    "version": "1.0.0",
    "private": true,
    "packageManager": "bun@1.4.4",
    "type": "module",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint . --max-warnings 0",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "type-check": "tsc --noEmit",
        "test": "bun test",
        "audit": "bun audit --audit-level=high",
        "generate:types": "payload generate:types",
        "generate:importmap": "payload generate:importmap",
        "migrate": "payload migrate",
        "migrate:create": "payload migrate:create",
        "migrate:status": "payload migrate:status",
        "migrate:check": "sh scripts/check-migrations.sh",
        "payload": "payload",
        "knip": "knip",
        "duplicates": "jscpd",
        "deps:check": "depcruise src scripts"
    },
    "dependencies": {
        "@payloadcms/db-sqlite": "3.94.0",
        "@payloadcms/next": "3.94.0",
        "@payloadcms/richtext-lexical": "3.94.0",
        "@payloadcms/storage-s3": "3.94.0",
        "@payloadcms/translations": "3.94.0",
        "@payloadcms/ui": "3.94.0",
        "@sindresorhus/slugify": "^4.0.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "feed": "^6.0.0",
        "graphql": "^16.15.0",
        "jose": "^6.2.18",
        "lucide-react": "1.76.0",
        "motion": "^14.14.0",
        "next": "16.4.6",
        "payload": "3.94.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-icons": "^5.7.0",
        "reading-time": "^1.5.0",
        "server-only": "^0.0.1",
        "sharp": "^0.35.5",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.6"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.5",
        "@tailwindcss/typography": "^0.5.16",
        "@types/bun": "^1.4.4",
        "@types/node": "^26",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "dependency-cruiser": "18.7.2",
        "eslint": "^10.15.0",
        "eslint-config-next": "16.4.6",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-perfectionist": "^5.14.0",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-react": "^7.37.4",
        "jscpd": "^5.4.3",
        "knip": "6.45.1",
        "prettier": "^3.10.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.5",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.73.0"
    },
    "trustedDependencies": [
        "unrs-resolver"
    ],
    "overrides": {
        "happy-dom": "^21.0.4"
    }
}
