        "zod": "^4.6.6"
    },
    "devDependencies": {
        "@happy-dom/global-registrator": "^21.0.4",
        "@jubstaa/config": "github:Jubstaaa/configs#26f273cf731f740acb5e5011b26b505b0631e943",
