        "@payloadcms/ui": "3.94.0",
        "@sindresorhus/slugify": "^4.0.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "feed": "^6.0.0",
        "graphql": "^16.15.0",
        "jose": "^6.2.18",
        "lucide-react": "1.76.0",
        "next": "16.4.6",
        "payload": "3.94.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-icons": "^5.7.0",
