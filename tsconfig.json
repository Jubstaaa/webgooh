{
    "extends": "@jubstaa/config/tsconfig/next",
    "compilerOptions": {
        "jsx": "react-jsx",
        "types": ["node", "bun"],
        "paths": {
            "@/*": ["./src/*"],
            "@payload-config": ["./src/payload.config.ts"],
            "@payload-types": ["./src/payload-types.ts"]
        }
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts"
    ],
    "exclude": ["node_modules"]
}
